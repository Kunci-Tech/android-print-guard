# Kunci Print Guard Configuration Example
# Copy this file to `printguard.properties` and fill in your values

PRINT_GUARD_ADMIN_PIN=1011
PRINT_GUARD_EPSON_IP=192.168.8.225
PRINT_GUARD_EPSON_PORT=9100
PRINT_GUARD_LOCAL_PROXY_PORT=9100
PRINT_GUARD_WEB_PORT=9101

# S3 Cloud Backup Configuration (Optional)
PRINT_GUARD_S3_ENDPOINT=https://is3.cloudhost.id
PRINT_GUARD_S3_REGION=us-east-1
PRINT_GUARD_S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_HERE
PRINT_GUARD_S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_KEY_HERE
PRINT_GUARD_S3_BUCKET_NAME=your-bucket-name
PRINT_GUARD_S3_FOLDER_PREFIX=kunci_receipt
